APP_ENV=production
ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate-a-strong-db-password
POSTGRES_DB=centro_viajero

DATABASE_URL=postgresql://postgres:generate-a-strong-db-password@db:5432/centro_viajero
JWT_SECRET=replace-with-a-long-random-secret-for-access-tokens
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-for-refresh-tokens
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
RATE_LIMIT_LOGIN_MAX_REQUESTS=5
RATE_LIMIT_CHATBOT_WINDOW_SECONDS=60
RATE_LIMIT_CHATBOT_MAX_REQUESTS=20

LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest
