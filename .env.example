POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=centro_viajero

# App environment
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
RATE_LIMIT_LOGIN_MAX_REQUESTS=5
RATE_LIMIT_CHATBOT_WINDOW_SECONDS=60
RATE_LIMIT_CHATBOT_MAX_REQUESTS=20

# Monitoring and observability
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backend example env
DATABASE_URL=postgresql://postgres:postgres@db:5432/centro_viajero
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Production notes
# Set APP_ENV=production and use different strong secrets for JWT_SECRET and JWT_REFRESH_SECRET before exposing the app to the internet.
# Do not use the default example values in a public deployment.
